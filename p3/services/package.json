{
  "name": "@zkag/services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Three protected demo services (Wiki, File Share, Admin Panel). Reachable only with a front-door assertion.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json && cp -R src/data dist/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zkag/shared": "0.1.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0"
  }
}
