# Copy to .env and replace every value for anything beyond a local demo.
# The gateway, SSO baseline and services REFUSE to start with NODE_ENV=production and these dev values.

# --- Gateway (M5) ---
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4000
ZK_PROFILE=integrated-access-v4        # integrated-access-v4 (team circuit) | p1-integrated-v3 (diagnostic)
# ARTIFACT_MANIFEST=../circuits/setup/integrated_access_v4.manifest.json   # default for v4
TRUSTED_ISSUER_FILE=.v4-demo/issuer-pin.json   # written by npm run v4:setup; or set TRUSTED_ISSUER_AX/AY
ALLOW_DEMO_KEYS=true                   # accept the team's DEV-ONLY keys (refused when NODE_ENV=production)
# REGISTRY_API=issuer-v1               # default for v4 (team issuer); p3-standin for v3
REGISTRY_URL=http://127.0.0.1:8100     # team issuer (v4); the P3 stand-in is :4600 (v3)
REGISTRY_ADMIN_TOKEN=dev-registry-admin-token-change-me-0000
ROOT_CACHE_MS=2000                     # session re-check cache, max 30000; new proofs always fetch the root
ROOT_STALENESS_SECONDS=30              # issuer.api insert-only staleness window
CHALLENGE_TTL_SECONDS=120
SESSION_TTL_SECONDS=600                # Project Scope: 10-minute sessions
EPOCH_SECONDS=600
NULLIFIER_MAX_PER_EPOCH=1
OPERATOR_TOKEN=dev-operator-token-change-me-000000
ASSERTION_SECRET_ZK=dev-zk-gateway-assertion-secret-change-me-0000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088
COOKIE_SECURE=false                    # must be true in production (HTTPS)
UPSTREAM_WIKI_URL=http://127.0.0.1:4101
UPSTREAM_FILE_SHARE_URL=http://127.0.0.1:4102
UPSTREAM_ADMIN_PANEL_URL=http://127.0.0.1:4103
SSO_GATEWAY_URL=http://127.0.0.1:4200
LOG_LEVEL=info

# --- Protected services ---
SERVICES_HOST=127.0.0.1
ASSERTION_SECRET_SSO=dev-sso-baseline-assertion-secret-change-me-000

# --- SSO baseline (M7) ---
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=zkag
OIDC_CLIENT_ID=zkag-sso-baseline
OIDC_CLIENT_SECRET=dev-sso-baseline-client-secret-change-me
OIDC_REDIRECT_URI=http://localhost:5173/sso/callback
POST_LOGOUT_REDIRECT_URI=http://localhost:5173/compare

# --- Wallet prover (team client adapter) ---
PROVER_PORT=4700
ISSUER_URL=http://127.0.0.1:8100
WALLET_ROOT=.v4-demo/wallets

# --- P2 diagnostic stand-in (v3 only) ---
STANDIN_PORT=4600
UI_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Benchmarks ---
BENCH_ITERATIONS=100
BENCH_PROVE_ITERATIONS=100
